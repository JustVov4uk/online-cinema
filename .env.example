PROJECT_NAME=Online Cinema API
API_V1_PREFIX=/api/v1
# PostgreSQL
POSTGRES_USER=online_cinema
POSTGRES_PASSWORD=online_cinema_password
POSTGRES_DB=online_cinema
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://online_cinema:online_cinema_password@localhost:5432/online_cinema
ALEMBIC_DATABASE_URL=postgresql+psycopg://online_cinema:online_cinema_password@localhost:5432/online_cinema
# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=false
CELERY_DELETE_EXPIRED_TOKENS_INTERVAL_SECONDS=3600
# Email / MailHog
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@online-cinema.local
FRONTEND_BASE_URL=http://localhost:8000
EMAIL_ENABLED=true
# MinIO / S3
MINIO_ROOT_USER=online_cinema_minio
MINIO_ROOT_PASSWORD=online_cinema_minio_password
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=online_cinema_minio
S3_SECRET_KEY=online_cinema_minio_password
S3_BUCKET_NAME=online-cinema-media
S3_PUBLIC_BASE_URL=http://localhost:9000/online-cinema-media
AVATAR_MAX_SIZE_BYTES=2000000
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
